# 复制为 .env 后填写真实值；.env 已被 .gitignore 忽略，禁止提交。

# 主库：MySQL 8.4 + PyMySQL，业务账号（非 root）。密码请替换 <password>。
DATABASE_URL=mysql+pymysql://codepilot:<password>@127.0.0.1:3306/codepilot_edu?charset=utf8mb4
# 集成测试库：库名必须以 _test 结尾，pytest 会重建该库的表。
TEST_DATABASE_URL=mysql+pymysql://codepilot:<password>@127.0.0.1:3306/codepilot_edu_test?charset=utf8mb4

# docker compose 初始化 MySQL 时读取（仅本地演示使用，root 不用于应用连接）
MYSQL_ROOT_PASSWORD=<root-password>
MYSQL_PASSWORD=<business-password>

# 服务绑定（P0 仅本地演示）
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 演示访问令牌：所有 /api/v1/* 接口都要求 X-Demo-Token。
# 留空时接口失败关闭（503 DEMO_TOKEN_NOT_CONFIGURED），不会静默放行。
DEMO_TOKEN=<demo-token>

# MySQL 连接池（秒）
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=5
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=5
DB_IO_TIMEOUT_SECONDS=10

# 评测限制
MAX_SOURCE_BYTES=16384
# Docker CLI 路径。已加入系统 PATH 时保持 docker 即可；
# Docker Desktop 安装后当前终端未刷新 PATH 时，可填完整路径。
JUDGE_DOCKER_BIN=docker
JUDGE_IMAGE=judge-c:latest
JUDGE_TIMEOUT_SECONDS=25
JUDGE_CASE_TIMEOUT_MS=2000
JUDGE_MAX_OUTPUT_BYTES=4096
JUDGE_MAX_CASES=8
JUDGE_MAX_CONCURRENCY=2

# AI 服务（兼容 OpenAI Chat Completions 协议）
AI_ENABLED=false
AI_BASE_URL=https://api.example.com/v1
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT=15
